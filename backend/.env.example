# ---- Razorpay TEST MODE credentials ----
# Get these from https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Database ----
DATABASE_URL=sqlite:///./paypilot.db

# ---- Agent / LLM ----
# If ANTHROPIC_API_KEY is not set, the agent runs in LOCAL_RULES mode:
# a deterministic, fully-functional rule-based NLU + tool-planner that needs
# no external API key. This keeps the demo runnable with zero external
# dependencies. Set the key to use real Claude tool-calling instead.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6

# ---- Policy engine (all amounts in INR paise are NOT used here - these are rupees) ----
MAX_TRANSACTION_AMOUNT_INR=5000
REQUIRE_USER_CONFIRMATION=true
MAX_PAYMENT_RETRY_ATTEMPTS=2
MAX_ORDER_CREATION_ATTEMPTS=1
ALLOW_AUTOMATIC_UPSELL=false
ALLOW_AUTOMATIC_PAYMENT=false
MAX_UPSELL_SUGGESTIONS=2

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
